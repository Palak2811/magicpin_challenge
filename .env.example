# Copy to your host's environment settings (never commit real keys)
TEAM_NAME=
TEAM_MEMBERS=
CONTACT_EMAIL=
# Optional LLM wording polish. RECOMMENDED: LLM_PROVIDER=none for the judged submission, because the challenge
# site rejects "unstable responses" and requires identical output for identical input. Enable only for experiments.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=8
TICK_LLM_BUDGET=18
# Max messages to the same merchant/customer in one tick (extras queue for later ticks). Default 1.
MAX_PER_RECIPIENT_PER_TICK=1
